{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/ledger_stop.py\"",
            "timeout": 20,
            "statusMessage": "Checking the ledger"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/owner_message_check.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
